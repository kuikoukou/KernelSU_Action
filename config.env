# =========================================================
# 小米 Note 3 - 终极稳定版配置 (修复 Clang 下载失败)
# =========================================================

# --- 核心源码 ---
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_xiaomi_jason
# 如果 14.0 分支报错，请尝试改为 lineage-21
KERNEL_SOURCE_BRANCH=14.0
KERNEL_CONFIG=jason_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true

# --- 编译器修复 (重点) ---
# 我们改用 2021 年的稳定分支 + Clang 11 (r383902)
# 这个版本在谷歌服务器上绝对存在，且最适合 4.4 老内核
USE_CUSTOM_CLANG=false
CLANG_BRANCH=master-kernel-build-2021
CLANG_VERSION=r383902

# 开启 GCC (老内核必须)
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# 开启 LLVM (适配 Android 14/15 环境)
EXTRA_CMDS="LD=ld.lld LLVM=1 LLVM_IAS=1"

# --- KernelSU-Next 设置 ---
ENABLE_KERNELSU=true
KERNELSU_TAG=v1.0.5
USE_KERNELSU_NEXT=true
APPLY_KSU_PATCH=true

# --- 稳定性 ---
DISABLE-LTO=true
DISABLE_CC_WERROR=true
BUILD_BOOT_IMG=false
