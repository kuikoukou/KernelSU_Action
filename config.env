# =========================================================
# 小米 Note 3 (jason) - crDroid Android 15 专用编译配置
# =========================================================

# --- 核心源码配置 ---
# crDroid 官方 Jason 内核源码
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_xiaomi_jason

# 源码分支
# 注意：crDroid 10/11 (A14/A15) 通常复用 14.0 分支
KERNEL_SOURCE_BRANCH=14.0

# 配置文件 (小米 Note 3 专用)
KERNEL_CONFIG=jason_defconfig

# 编译出的镜像文件名 (4.4 内核标准)
KERNEL_IMAGE_NAME=Image.gz-dtb

# 架构
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true

# --- 编译器设置 (修复之前报错的关键) ---
# 必须填入具体的 Clang 版本，否则下载时会报 404 错误
# r450784d 是配合 Android 14/15 比较通用的版本
USE_CUSTOM_CLANG=false
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784d

# 开启 GCC (Linux 4.4 老内核必须依赖 GCC)
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# ⚠️ 关键参数：适配 Android 15 的编译环境
# 开启 LLVM 链接，否则会在编译中途报错
EXTRA_CMDS="LD=ld.lld LLVM=1 LLVM_IAS=1"

# --- KernelSU-Next 设置 (核心功能) ---
# 开启 KernelSU
ENABLE_KERNELSU=true

# ⚠️ 必须使用 Next 版本 (v1.0.5)
# 官方版不支持 4.4 内核，必须用 Next
KERNELSU_TAG=v1.0.5

# 告诉脚本去拉取 Next 的仓库而不是官方的
USE_KERNELSU_NEXT=true

# 强制打入补丁
APPLY_KSU_PATCH=true

# --- 稳定性与修复 ---
# 关闭 LTO (Link Time Optimization)
# 4.4 老内核开 LTO 极易编译失败或开机死机，必须关闭
DISABLE-LTO=true

# 关闭警告视为错误 (防止因老代码格式问题停止编译)
DISABLE_CC_WERROR=true

# --- 输出设置 ---
# 不需要 boot.img，我们只用 AnyKernel3 刷机包，兼容性最好
BUILD_BOOT_IMG=false
